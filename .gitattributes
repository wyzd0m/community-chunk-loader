# Minecraft reads .mcfunction line by line; keep them LF everywhere so a
# Windows checkout does not ship CRLF into the server's datapack folder.
*.mcfunction text eol=lf
*.json       text eol=lf
pack.mcmeta  text eol=lf
*.md         text eol=lf
*.sh         text eol=lf
*.ps1        text eol=crlf
*.yml        text eol=lf
